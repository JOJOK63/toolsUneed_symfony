{% extends 'base.html.twig' %}

{% block title %}Listes des budgets{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/budget.css') }}">
{% endblock %}

{% block body %}
<style>

</style>


<div class="example-wrapper">
    <h1>Liste des budgets </h1>
    {% set resultat = addition(2,5) %}
    <p>{{ budgets | taille }}</p>
    <p> {{ resultat }}</p>
    <ul>
        {% for budget in budgets %}
            <li>
                <a href="{{ path('app_budget_show', {'id': budget.id}) }}">
                    {{ budget.name }}
                </a>
            </li>

        {% endfor %}
    </ul>


</div>
{% endblock %}
